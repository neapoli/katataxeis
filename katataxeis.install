<?php

/**
 * @file
 * Installazione, aggiornamenti e disinstallazione di Katatáxeis.
 */

use Drupal\webform\Entity\WebformOptions;

/**
 * Nome macchina del menù in cui pubblicare le voci delle graduatorie.
 */
const KATATAXEIS_MENU_NAME = 'azioni-principali';

/**
 * URI delle pagine delle graduatorie, nelle varianti salvabili da interfaccia.
 *
 * Le voci di menù vere e proprie sono definite in katataxeis.links.menu.yml:
 * qui servono solo per riconoscere ed eliminare eventuali link creati a mano.
 */
const KATATAXEIS_MENU_LINK_URIS = [
  'internal:/form/graduatoria-interna-ata',
  'base:form/graduatoria-interna-ata',
  'entity:webform/graduatoria_interna_ata',
  'internal:/admin/graduatorie-interne',
  'base:admin/graduatorie-interne',
  'route:view.graduatorie_interne.page_1',
  'internal:/admin/graduatorie-interne-elenco',
  'base:admin/graduatorie-interne-elenco',
  'route:view.graduatorie_interne_personale.page_1',
];

/**
 * Implements hook_install().
 */
function katataxeis_install() {
  katataxeis_installa_config_update('katataxeis');
  _katataxeis_delete_manual_menu_links();
}

/**
 * Elimina le voci di menù create a mano verso le pagine delle graduatorie.
 *
 * Le voci sono fornite dal modulo (katataxeis.links.menu.yml), quindi ogni
 * link equivalente creato manualmente nel menù sarebbe un doppione.
 *
 * @return int
 *   Il numero di voci eliminate.
 */
function _katataxeis_delete_manual_menu_links() {
  if (!\Drupal::moduleHandler()->moduleExists('menu_link_content')) {
    return 0;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $deleted = 0;

  foreach (KATATAXEIS_MENU_LINK_URIS as $uri) {
    $links = $storage->loadByProperties([
      'menu_name' => KATATAXEIS_MENU_NAME,
      'link.uri' => $uri,
    ]);

    if ($links) {
      $storage->delete($links);
      $deleted += count($links);
    }
  }

  if ($deleted) {
    \Drupal::logger('katataxeis')->notice(
      'Rimosse @count voci di menù duplicate verso le pagine delle graduatorie: le voci sono ora fornite dal modulo.',
      ['@count' => $deleted]
    );
  }

  return $deleted;
}

/**
 * Implements hook_uninstall().
 *
 * Cancella il formulario ATA, le viste e le liste di opzioni del modulo (vedi
 * katataxeis_cancella_configurazioni()). I formulari dei docenti stanno nei
 * sottomoduli, che Drupal fa disinstallare prima di questo.
 */
function katataxeis_uninstall() {
  katataxeis_cancella_configurazioni('katataxeis');
}

/**
 * Aggiunge le voci delle graduatorie al menù "Azioni principali".
 */
function katataxeis_update_10002() {
  $deleted = _katataxeis_delete_manual_menu_links();

  // Ricostruisce l'albero dei menù per rendere subito visibili le nuove voci.
  \Drupal::service('plugin.manager.menu.link')->rebuild();

  return $deleted
    ? t('Voci di menù aggiunte; rimosse @count voci duplicate create manualmente.', ['@count' => $deleted])
    : t('Voci di menù aggiunte al menù "Azioni principali".');
}

/**
 * Attiva il sottomodulo dell'istituto comprensivo dove servono i suoi formulari.
 *
 * I formulari dei docenti di infanzia, primaria e secondaria di I grado sono
 * passati nel sottomodulo katataxeis_comprensivo, quello del II grado in
 * katataxeis_secondo_grado. Una scuola che già usava Katatáxeis ha i
 * formulari del comprensivo: il sottomodulo si attiva da solo, e formulari,
 * schede e viste restano dove sono. Il II grado invece lo attiva la scuola.
 */
function katataxeis_update_10004() {
  $comprensivo = [
    'graduatoria_interna_docenti_inf',
    'graduatoria_interna_docenti_pri',
    'graduatoria_interna_docenti_scu',
  ];
  if (\Drupal::moduleHandler()->moduleExists('katataxeis_comprensivo')
    || !\Drupal::entityTypeManager()->getStorage('webform')->loadMultiple($comprensivo)) {
    return t('Nessun sottomodulo da attivare.');
  }

  \Drupal::service('module_installer')->install(['katataxeis_comprensivo']);
  return t('Attivato il sottomodulo katataxeis_comprensivo: i formulari di infanzia, primaria e secondaria di I grado ora appartengono a lui.');
}

/**
 * Aggiunge i posti di lingua inglese e di educazione motoria della primaria.
 *
 * Nella primaria le graduatorie sono distinte anche per questi due posti
 * (art. 19, comma 3, del CCNI). La lista dei posti è della scuola: si
 * aggiungono solo le due voci, se mancano, senza toccare le altre.
 */
function katataxeis_update_10005() {
  $lista = WebformOptions::load('tipologia_posto_primaria');
  if (!$lista) {
    return t('Lista dei posti della primaria assente: niente da fare.');
  }

  $voci = $lista->getOptions();
  $aggiunte = [];
  foreach (['Lingua inglese', 'Educazione motoria'] as $voce) {
    if (!isset($voci[$voce])) {
      $voci[$voce] = $voce;
      $aggiunte[] = $voce;
    }
  }
  if (!$aggiunte) {
    return t('I posti di lingua inglese ed educazione motoria c\'erano già.');
  }

  $lista->setOptions($voci)->save();
  return t('Aggiunti alla lista dei posti della primaria: @voci.', ['@voci' => implode(', ', $aggiunte)]);
}
